{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kona",
  "version": "0.1.0",
  "identifier": "dev.kona.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../../web/public"
  },
  "app": {
    "windows": [
      {
        "title": "Kona RTL Verification",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://127.0.0.1:4173; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
