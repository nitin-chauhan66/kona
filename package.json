{
  "name": "kona",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && node --test tests/*.test.mjs",
    "kona": "node apps/cli/dist/cli.js",
    "dev": "node apps/web/server.mjs",
    "watch": "node apps/cli/dist/cli.js watch examples/kona.yaml",
    "package:web": "docker build -t kona-web:local -f apps/web/Dockerfile .",
    "start:packaged": "docker run --rm -p 4173:4173 kona-web:local"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.2"
  }
}
